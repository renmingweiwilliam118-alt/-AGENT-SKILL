diff --git a/notes-repository.js b/notes-repository.js
new file mode 100644
index 0000000..ce12933
--- /dev/null
+++ b/notes-repository.js
@@ -0,0 +1,55 @@
+// Storage abstraction so the API can swap backends (memory, sqlite, redis)
+// without touching request handling.
+class NotesRepository {
+  findAll() { throw new Error('not implemented'); }
+  findById(_id) { throw new Error('not implemented'); }
+  create(_fields) { throw new Error('not implemented'); }
+  update(_id, _fields) { throw new Error('not implemented'); }
+  deleteById(_id) { throw new Error('not implemented'); }
+  clear() { throw new Error('not implemented'); }
+}
+
+class InMemoryNotesRepository extends NotesRepository {
+  constructor() {
+    super();
+    this.nextId = 1;
+    this.notes = new Map();
+  }
+
+  findAll() { return [...this.notes.values()]; }
+
+  findById(id) { return this.notes.get(id) ?? null; }
+
+  create(fields) {
+    const note = { id: this.nextId++, ...fields };
+    this.notes.set(note.id, note);
+    return note;
+  }
+
+  update(id, fields) {
+    const existing = this.findById(id);
+    if (!existing) return null;
+    const updated = { ...existing, ...fields, id };
+    this.notes.set(id, updated);
+    return updated;
+  }
+
+  deleteById(id) { return this.notes.delete(id); }
+
+  clear() {
+    this.nextId = 1;
+    this.notes.clear();
+  }
+}
+
+const REPOSITORIES = {
+  memory: () => new InMemoryNotesRepository(),
+};
+
+function createNotesRepository(kind = 'memory') {
+  const factory = REPOSITORIES[kind];
+  if (!factory) throw new Error(`unknown notes store: ${kind}`);
+  return factory();
+}
+
+module.exports = { NotesRepository, InMemoryNotesRepository, createNotesRepository };
