@@ -0,0 +1,9 @@
+from abc import ABC, abstractmethod
+
+
+class Notifier(ABC):
+    """A destination for operational alerts (Slack, email, PagerDuty, ...)."""
+
+    @abstractmethod
+    def send(self, message: str) -> None:
+        """Deliver `message`. Implementations must never raise."""
diff --git a/notifications/factory.py b/notifications/factory.py
new file mode 100644
index 0000000..b077bcc
--- /dev/null
+++ b/notifications/factory.py
@@ -0,0 +1,19 @@
+from typing import Callable
+
+from notifications.base import Notifier
+from notifications.slack import SlackNotifier
+
+_REGISTRY: dict[str, Callable[[], Notifier]] = {
+    "slack": SlackNotifier,
+}
+
+
+def register_notifier(kind: str, factory: Callable[[], Notifier]) -> None:
+    _REGISTRY[kind] = factory
+
+
+def get_notifier(kind: str) -> Notifier:
+    try:
+        return _REGISTRY[kind]()
+    except KeyError:
+        raise ValueError(f"unknown notifier: {kind}") from None
diff --git a/notifications/slack.py b/notifications/slack.py
new file mode 100644
