 export function parseDuration(input: string): number {
-  const match = /^(\d+)(ms|s|m|h)$/.exec(input);
-  return Number(match![1]) * UNIT_MS[match![2]];
+  const match = /^(\d+)(ms|s|m|h)$/.exec(input.trim());
+  if (!match) {
