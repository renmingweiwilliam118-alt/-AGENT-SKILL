diff --git a/src/duration.test.ts b/src/duration.test.ts
index 02782cf..8a06f0a 100644
--- a/src/duration.test.ts
+++ b/src/duration.test.ts
@@ -8,4 +8,29 @@ describe('parseDuration', () => {
     expect(parseDuration('5m')).toBe(300_000);
     expect(parseDuration('2h')).toBe(7_200_000);
   });
+
+  it('accepts zero', () => {
+    expect(parseDuration('0s')).toBe(0);
+  });
+
+  it('ignores surrounding whitespace', () => {
+    expect(parseDuration(' 5m ')).toBe(300_000);
+    expect(parseDuration('\t30s\n')).toBe(30_000);
+  });
+
+  it.each([
+    ['5x'],
+    [''],
+    ['   '],
+    ['5'],
+    ['m'],
+    ['-5s'],
+    ['1.5s'],
+    ['5 m'],
+    ['5M'],
+    ['5mm'],
+  ])('throws RangeError naming %j', (bad) => {
+    expect(() => parseDuration(bad)).toThrow(RangeError);
+    expect(() => parseDuration(bad)).toThrow(JSON.stringify(bad));
+  });
 });
diff --git a/src/duration.ts b/src/duration.ts
