@@ -0,0 +1,31 @@
+package server
+
+import (
+	"net/http"
+	"net/http/httptest"
+	"testing"
+)
+
+func TestHealthzMethods(t *testing.T) {
+	cases := []struct {
+		method string
+		want   int
+	}{
+		{http.MethodGet, http.StatusOK},
+		{http.MethodHead, http.StatusOK},
+		{http.MethodPost, http.StatusMethodNotAllowed},
+		{http.MethodDelete, http.StatusMethodNotAllowed},
+	}
+	for _, tc := range cases {
+		t.Run(tc.method, func(t *testing.T) {
+			rec := httptest.NewRecorder()
+			Healthz(rec, httptest.NewRequest(tc.method, "/healthz", nil))
+			if rec.Code != tc.want {
+				t.Fatalf("%s /healthz = %d, want %d", tc.method, rec.Code, tc.want)
+			}
+			if tc.want == http.StatusMethodNotAllowed && rec.Header().Get("Allow") != "GET, HEAD" {
+				t.Fatalf("Allow header = %q", rec.Header().Get("Allow"))
+			}
+		})
+	}
+}
