diff --git a/internal/server/health.go b/internal/server/health.go
index 326cb95..9d4c3f2 100644
--- a/internal/server/health.go
+++ b/internal/server/health.go
@@ -5,6 +5,13 @@ import "net/http"
 // Healthz reports that the process is up. It deliberately checks no
 // dependencies; readiness lives in /readyz.
 func Healthz(w http.ResponseWriter, r *http.Request) {
+	switch r.Method {
+	case http.MethodGet, http.MethodHead:
+	default:
+		w.Header().Set("Allow", "GET, HEAD")
+		http.Error(w, "method not allowed", http.StatusMethodNotAllowed)
+		return
+	}
 	w.Header().Set("Content-Type", "application/json")
 	w.WriteHeader(http.StatusOK)
 	_, _ = w.Write([]byte(`{"status":"ok"}`))
