+++ b/src/formatters/registry.js
@@ -0,0 +1,35 @@
+// Pluggable per-currency formatter registry. Third parties can register
+// additional currencies (and per-country tax display) without editing core.
+const formatters = new Map();
+
+class PriceFormatter {
+  constructor({ symbol, decimals = 2, symbolPosition = 'prefix', separator = '.' }) {
+    this.symbol = symbol;
+    this.decimals = decimals;
+    this.symbolPosition = symbolPosition;
+    this.separator = separator;
+  }
+
+  format(minorUnits) {
+    const factor = 10 ** this.decimals;
+    const major = Math.floor(minorUnits / factor);
+    const minor = String(minorUnits % factor).padStart(this.decimals, '0');
+    const amount = this.decimals ? `${major}${this.separator}${minor}` : String(major);
+    return this.symbolPosition === 'prefix' ? this.symbol + amount : `${amount} ${this.symbol}`;
+  }
+}
+
+function registerFormatter(code, formatter) {
+  if (!(formatter instanceof PriceFormatter)) {
+    throw new TypeError(`formatter for ${code} must extend PriceFormatter`);
+  }
+  formatters.set(code.toUpperCase(), formatter);
+}
+
+function getFormatter(code) {
+  const formatter = formatters.get(String(code).toUpperCase());
+  if (!formatter) throw new Error(`no price formatter registered for ${code}`);
+  return formatter;
+}
+
+module.exports = { PriceFormatter, registerFormatter, getFormatter };
