@@ -0,0 +1,12 @@
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { DEFAULT_SETTINGS, applyOverrides } from './settings.js';
+
+test('applyOverrides leaves its input untouched', () => {
+  const before = JSON.stringify(DEFAULT_SETTINGS);
+  const next = applyOverrides(DEFAULT_SETTINGS, { units: 'imperial', theme: { mode: 'dark' } });
+  assert.equal(JSON.stringify(DEFAULT_SETTINGS), before);
+  assert.equal(next.units, 'imperial');
+  assert.deepEqual(next.theme, { mode: 'dark', accent: '#2f5d50' });
+  assert.notEqual(next.theme, DEFAULT_SETTINGS.theme);
+});
