diff --git a/src/flags/FlagContext.tsx b/src/flags/FlagContext.tsx
new file mode 100644
index 0000000..abdc702
--- /dev/null
+++ b/src/flags/FlagContext.tsx
@@ -0,0 +1,19 @@
+import { createContext, useContext, useEffect, useState, type ReactNode } from 'react';
+import type { FlagName } from './FlagProvider';
+import { FlagService, flagService } from './FlagService';
+
+const FlagContext = createContext<FlagService>(flagService);
+
+export function FlagsProvider({ service = flagService, children }: { service?: FlagService; children: ReactNode }) {
+  return <FlagContext.Provider value={service}>{children}</FlagContext.Provider>;
+}
+
+export function useFlag(name: FlagName): boolean {
+  const service = useContext(FlagContext);
+  const [value, setValue] = useState(() => service.isEnabled(name));
+  useEffect(
+    () => service.subscribe((changed, next) => { if (changed === name) setValue(next); }),
+    [service, name],
+  );
+  return value;
+}
diff --git a/src/flags/FlagProvider.ts b/src/flags/FlagProvider.ts
new file mode 100644
index 0000000..00f6f3e
--- /dev/null
+++ b/src/flags/FlagProvider.ts
@@ -0,0 +1,18 @@
+export type FlagName = 'showBeta';
+
+export interface FlagProvider {
+  /** Returns the flag value, or undefined when the provider has no opinion. */
+  get(name: FlagName): boolean | undefined;
+}
+
+const ENV_KEYS: Record<FlagName, string | undefined> = {
+  showBeta: process.env.NEXT_PUBLIC_SHOW_BETA,
+};
+
+export class EnvFlagProvider implements FlagProvider {
+  get(name: FlagName): boolean | undefined {
+    const raw = ENV_KEYS[name];
+    if (raw === undefined) return undefined;
+    return raw !== 'false';
+  }
+}
diff --git a/src/flags/FlagService.ts b/src/flags/FlagService.ts
new file mode 100644
