--- /dev/null
+++ b/src/flags/FlagService.ts
@@ -0,0 +1,33 @@
+import type { FlagName, FlagProvider } from './FlagProvider';
+import { EnvFlagProvider } from './FlagProvider';
+
+type Listener = (name: FlagName, value: boolean) => void;
+
+const DEFAULTS: Record<FlagName, boolean> = { showBeta: true };
+
+export class FlagService {
+  private cache = new Map<FlagName, boolean>();
+  private listeners = new Set<Listener>();
+
+  constructor(private readonly providers: FlagProvider[]) {}
+
+  isEnabled(name: FlagName): boolean {
+    const cached = this.cache.get(name);
+    if (cached !== undefined) return cached;
+    const value = this.providers.map((p) => p.get(name)).find((v) => v !== undefined) ?? DEFAULTS[name];
+    this.cache.set(name, value);
+    return value;
+  }
+
+  override(name: FlagName, value: boolean): void {
+    this.cache.set(name, value);
+    this.listeners.forEach((fn) => fn(name, value));
+  }
+
+  subscribe(fn: Listener): () => void {
+    this.listeners.add(fn);
+    return () => this.listeners.delete(fn);
+  }
+}
+
+export const flagService = new FlagService([new EnvFlagProvider()]);
