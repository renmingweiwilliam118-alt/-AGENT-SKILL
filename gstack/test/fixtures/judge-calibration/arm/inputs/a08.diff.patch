+def test_parses_created_at_as_aware_datetime(tmp_path):
+    f = tmp_path / "orders.csv"
+    f.write_text("id,total_cents,created_at\nA1,1999,2026-05-01T14:03:00+00:00\n")
+    created = load_orders(f)[0]["created_at"]
+    assert created == datetime(2026, 5, 1, 14, 3, tzinfo=timezone.utc)
+    assert created.tzinfo is not None
