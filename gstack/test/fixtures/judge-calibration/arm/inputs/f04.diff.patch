@@ -0,0 +1,98 @@
+// Package retry is a small, reusable retry toolkit for outbound calls.
+package retry
+
+import (
+	"context"
+	"errors"
+	"math/rand"
+	"time"
+)
+
+// Strategy decides how long to wait before the next attempt.
+type Strategy interface {
+	Delay(attempt int) time.Duration
+}
+
+// ConstantBackoff waits the same duration between attempts.
+type ConstantBackoff struct{ Wait time.Duration }
+
+func (b ConstantBackoff) Delay(int) time.Duration { return b.Wait }
+
+// ExponentialBackoff doubles the wait each attempt up to Max.
+type ExponentialBackoff struct {
+	Base time.Duration
+	Max  time.Duration
+}
+
+func (b ExponentialBackoff) Delay(attempt int) time.Duration {
+	d := b.Base << attempt
+	if b.Max > 0 && d > b.Max {
+		return b.Max
+	}
+	return d
+}
+
+type config struct {
+	maxAttempts int
+	strategy    Strategy
+	jitter      float64
+	onRetry     func(attempt int, err error)
+}
+
+// Option configures Do.
+type Option func(*config)
+
+func WithMaxAttempts(n int) Option { return func(c *config) { c.maxAttempts = n } }
+
+func WithStrategy(s Strategy) Option { return func(c *config) { c.strategy = s } }
+
+func WithJitter(fraction float64) Option { return func(c *config) { c.jitter = fraction } }
+
+func WithOnRetry(f func(int, error)) Option { return func(c *config) { c.onRetry = f } }
+
+type permanentError struct{ err error }
+
+func (p permanentError) Error() string { return p.err.Error() }
+func (p permanentError) Unwrap() error { return p.err }
+
+// Permanent marks an error as non-retryable. Permanent(nil) is nil.
+func Permanent(err error) error {
+	if err == nil {
+		return nil
+	}
+	return permanentError{err}
+}
+
+// Do runs fn until it succeeds, returns a Permanent error, or attempts run out.
+func Do(ctx context.Context, fn func(context.Context) error, opts ...Option) error {
+	cfg := config{maxAttempts: 3, strategy: ConstantBackoff{Wait: 100 * time.Millisecond}}
+	for _, opt := range opts {
+		opt(&cfg)
+	}
+	var err error
+	for attempt := 0; attempt < cfg.maxAttempts; attempt++ {
+		if err = fn(ctx); err == nil {
+			return nil
+		}
+		var perm permanentError
+		if errors.As(err, &perm) {
+			return perm.err
+		}
+		if attempt == cfg.maxAttempts-1 {
+			break
+		}
+		if cfg.onRetry != nil {
+			cfg.onRetry(attempt+1, err)
+		}
+		wait := cfg.strategy.Delay(attempt)
+		if cfg.jitter > 0 {
+			wait += time.Duration(rand.Float64() * cfg.jitter * float64(wait))
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(wait):
+		}
+	}
+	return err
+}
