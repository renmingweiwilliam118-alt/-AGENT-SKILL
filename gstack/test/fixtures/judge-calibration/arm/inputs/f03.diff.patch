new file mode 100644
index 0000000..302c50c
--- /dev/null
+++ b/tests/test_config.py
@@ -0,0 +1,20 @@
+from worker.config import DEFAULT_TIMEOUT, worker_timeout
+
+
+def test_reads_timeout_from_toml(tmp_path, monkeypatch):
+    monkeypatch.delenv("WORKER_TIMEOUT", raising=False)
+    cfg = tmp_path / "config.toml"
+    cfg.write_text('[worker]\ntimeout_seconds = 90  # slow upstream\n')
+    assert worker_timeout(cfg) == 90
+
+
+def test_env_overrides_file(tmp_path, monkeypatch):
+    monkeypatch.setenv("WORKER_TIMEOUT", "5")
+    cfg = tmp_path / "config.toml"
+    cfg.write_text("[worker]\ntimeout_seconds = 90\n")
+    assert worker_timeout(cfg) == 5
+
+
+def test_missing_file_uses_default(tmp_path, monkeypatch):
+    monkeypatch.delenv("WORKER_TIMEOUT", raising=False)
+    assert worker_timeout(tmp_path / "absent.toml") == DEFAULT_TIMEOUT
